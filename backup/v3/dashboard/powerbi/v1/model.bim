          {"name":"sla_resolucion_h",         "dataType":"decimal", "sourceColumn":"sla_resolucion_h",         "lineageTag":"c2006"},
          {"name":"total_tickets",            "dataType":"int64",   "sourceColumn":"total_tickets",            "lineageTag":"c2007"},
          {"name":"promedio_horas_resolucion","dataType":"decimal", "sourceColumn":"promedio_horas_resolucion","lineageTag":"c2008"},
          {"name":"dentro_sla",               "dataType":"int64",   "sourceColumn":"dentro_sla",               "lineageTag":"c2009"},
          {"name":"fuera_sla",                "dataType":"int64",   "sourceColumn":"fuera_sla",                "lineageTag":"c2010"},
