      {
        "name": "_Medidas",
        "lineageTag": "a1b2c3d4-0099-0099-0099-000000000099",
        "partitions": [{
          "name": "_Medidas-part",
          "source": { "type": "calculated", "expression": "DATATABLE(\"x\", STRING, {{\"\"}})" }
        }],
        "columns": [
          {"name":"x","dataType":"string","sourceColumn":"[x]","lineageTag":"c9999","isHidden":true}
        ],
        "measures": [
          {
            "name": "Total Tickets",
            "expression": "COUNTROWS(tickets)",
            "formatString": "#,0",
            "lineageTag": "m0001"
          },
          {
            "name": "Tickets Activos",
            "expression": "CALCULATE(COUNTROWS(tickets), tickets[estado_id] NOT IN {8, 9})",
            "formatString": "#,0",
            "lineageTag": "m0002"
          },
          {
            "name": "Tickets Cerrados",
            "expression": "CALCULATE(COUNTROWS(tickets), tickets[estado_id] = 8)",
            "formatString": "#,0",
            "lineageTag": "m0003"
          },
          {
            "name": "Tickets Rechazados",
            "expression": "CALCULATE(COUNTROWS(tickets), tickets[estado_id] = 9)",
            "formatString": "#,0",
            "lineageTag": "m0004"
          },
          {
            "name": "Sin Asignar",
            "expression": "CALCULATE(COUNTROWS(tickets), ISBLANK(tickets[admin_id]), tickets[estado_id] NOT IN {8, 9})",
            "formatString": "#,0",
            "lineageTag": "m0005"
          },
          {
            "name": "Criticos Activos",
            "expression": "CALCULATE(COUNTROWS(tickets), tickets[prioridad_id] = 4, tickets[estado_id] NOT IN {8, 9})",
            "formatString": "#,0",
            "lineageTag": "m0006"
          },
          {
            "name": "Con Gasto",
            "expression": "CALCULATE(COUNTROWS(tickets), tickets[genera_gasto] = 1)",
            "formatString": "#,0",
            "lineageTag": "m0007"
          },
          {
            "name": "Dentro SLA",
            "expression": "CALCULATE(COUNTROWS(v_sla_cumplimiento), v_sla_cumplimiento[resultado_sla] = \"dentro_sla\")",
            "formatString": "#,0",
            "lineageTag": "m0008"
          },
          {
            "name": "Fuera SLA",
            "expression": "CALCULATE(COUNTROWS(v_sla_cumplimiento), v_sla_cumplimiento[resultado_sla] = \"fuera_sla\")",
            "formatString": "#,0",
            "lineageTag": "m0009"
          },
          {
            "name": "% Cumplimiento SLA",
            "expression": "DIVIDE([Dentro SLA], [Dentro SLA] + [Fuera SLA], BLANK())",
            "formatString": "0.0%",
            "lineageTag": "m0010"
          },
          {
            "name": "Vencidos SLA",
            "expression": "CALCULATE(COUNTROWS(v_tickets_pendientes), v_tickets_pendientes[sla_estado] = \"vencido\")",
            "formatString": "#,0",
            "lineageTag": "m0011"
          },
          {
            "name": "En Riesgo SLA",
            "expression": "CALCULATE(COUNTROWS(v_tickets_pendientes), v_tickets_pendientes[sla_estado] = \"en_riesgo\")",
            "formatString": "#,0",
            "lineageTag": "m0012"
          },
          {
            "name": "Promedio Resolucion h",
            "expression": "AVERAGEX(FILTER(tickets, tickets[estado_id] = 8 && NOT ISBLANK(tickets[closed_at])), DATEDIFF(tickets[created_at], tickets[closed_at], HOUR))",
            "formatString": "0.0 \\h",
            "lineageTag": "m0013"
          },
          {
            "name": "Creados Ultimos 30d",
            "expression": "CALCULATE([Total Tickets], DATESINPERIOD(tickets[created_at], TODAY(), -30, DAY))",
            "formatString": "#,0",
            "lineageTag": "m0014"
          },
          {
            "name": "Cerrados Ultimos 30d",
            "expression": "CALCULATE([Tickets Cerrados], DATESINPERIOD(tickets[closed_at], TODAY(), -30, DAY))",
            "formatString": "#,0",
            "lineageTag": "m0015"
          },
          {
            "name": "Tasa Resolucion",
            "expression": "DIVIDE([Tickets Cerrados], [Total Tickets], 0)",
            "formatString": "0.0%",
            "lineageTag": "m0016"
          },
          {
            "name": "Color SLA",
            "expression": "SWITCH(SELECTEDVALUE(v_tickets_pendientes[sla_estado]), \"vencido\", \"#DC2626\", \"en_riesgo\", \"#D97706\", \"ok\", \"#16A34A\", \"sin_sla\", \"#94A3B8\", \"#94A3B8\")",
            "lineageTag": "m0017"
          }
        ]
      }

    ],

